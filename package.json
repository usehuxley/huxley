{
	"name": "huxley",
	"private": true,
	"license": "MIT",
	"type": "module",
	"packageManager": "pnpm@12.21.0",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"dev": "pnpm --parallel --filter './apps/*' dev",
		"build": "pnpm --recursive build",
		"check": "pnpm --recursive check",
		"lint": "pnpm --recursive lint",
		"format": "pnpm --recursive format",
		"test": "pnpm --recursive test:unit --run",
		"test:e2e": "pnpm --recursive test:e2e",
		"api-client:generate": "pnpm --filter @usehuxley/api-client generate"
	},
	"devDependencies": {
		"lefthook": "^2.2.2",
		"prettier": "^3.10.1"
	}
}
