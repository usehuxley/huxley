# Copy to .env (install.sh does this) and adjust.

# Public hostnames. Point DNS at this host; Caddy obtains certificates.
HUXLEY_DOMAIN=localhost
HUXLEY_PORTAL_DOMAIN=portal.localhost

# Image tag to run when pulling instead of building.
HUXLEY_VERSION=latest

HUXLEY_ENVIRONMENT=production

# OTLP gRPC endpoint for traces, metrics, and logs. Leave empty to disable.
# With --profile observability: http://otel-collector:4317
HUXLEY_OTLP_ENDPOINT=

# Outgoing email (password reset, invitations, verification). Leave
# HUXLEY_SMTP_URL empty to turn email off. Examples:
#   smtps://user:pass@smtp.example.com       (TLS, port 465)
#   smtp://user:pass@smtp.example.com?tls=required   (STARTTLS, port 587)
HUXLEY_SMTP_URL=
HUXLEY_EMAIL_FROM=Huxley <huxley@example.com>

# Behind a CDN (Cloudflare, Azure Front Door…): the header it sets to the
# client's address, e.g. CF-Connecting-IP. Only with the origin locked to the
# CDN; see docs/operations.md, "Behind a CDN".
HUXLEY_CLIENT_IP_HEADER=
