{
	"compilerOptions": {
		"strict": true,
		"target": "es2024",
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"verbatimModuleSyntax": true,
		"allowImportingTsExtensions": true,
		"erasableSyntaxOnly": true,
		"isolatedModules": true,
		"skipLibCheck": true,
		"noEmit": true,
		"types": ["node"],
		"lib": ["es2024"]
	},
	"include": ["src", "scripts", "test", "../../examples/sdk"]
}
