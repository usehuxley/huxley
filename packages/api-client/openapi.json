{
	"openapi": "3.1.0",
	"info": {
		"title": "Huxley API",
		"description": "Huxley platform API. See https://docs.usehuxley.com for conventions.",
		"license": {
			"name": "MIT",
			"identifier": "MIT"
		},
		"version": "0.1.0"
	},
	"paths": {
		"/api/v1/auth/login": {
			"post": {
				"tags": ["auth"],
				"summary": "Signs in with email and password. Sets the session cookie.",
				"operationId": "login",
				"requestBody": {
					"content": {
						"application/json": {
							"schema": {
								"$ref": "#/components/schemas/LoginRequest"
							}
						}
					},
					"required": true
				},
				"responses": {
					"200": {
						"description": "Signed in; session cookie set",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/UserView"
								}
							}
						}
					},
					"401": {
						"description": "Wrong email or password, or the account is disabled or locked",
						"content": {
							"application/problem+json": {
								"schema": {
									"$ref": "#/components/schemas/ApiError"
								}
							}
						}
					},
					"429": {
						"description": "Too many attempts from this address",
						"content": {
							"application/problem+json": {
								"schema": {
									"$ref": "#/components/schemas/ApiError"
								}
							}
						}
					}
				}
			}
		},
		"/api/v1/auth/logout": {
			"post": {
				"tags": ["auth"],
				"summary": "Signs out the current session and clears the cookie.",
				"operationId": "logout",
				"responses": {
					"204": {
						"description": "Signed out"
					}
				}
			}
		},
		"/api/v1/auth/me": {
			"get": {
				"tags": ["auth"],
				"summary": "The signed-in user.",
				"operationId": "me",
				"responses": {
					"200": {
						"description": "The signed-in user",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/UserView"
								}
							}
						}
					},
					"401": {
						"description": "Not signed in",
						"content": {
							"application/problem+json": {
								"schema": {
									"$ref": "#/components/schemas/ApiError"
								}
							}
						}
					}
				}
			}
		},
		"/api/v1/auth/password": {
			"post": {
				"tags": ["auth"],
				"summary": "Changes the signed-in user's password. Signs out all their other sessions.",
				"operationId": "change_password",
				"requestBody": {
					"content": {
						"application/json": {
							"schema": {
								"$ref": "#/components/schemas/ChangePasswordRequest"
							}
						}
					},
					"required": true
				},
				"responses": {
					"204": {
						"description": "Password changed; other sessions signed out"
					},
					"422": {
						"description": "Current password wrong or new password too weak",
						"content": {
							"application/problem+json": {
								"schema": {
									"$ref": "#/components/schemas/ApiError"
								}
							}
						}
					}
				}
			}
		},
		"/api/v1/auth/sessions": {
			"get": {
				"tags": ["auth"],
				"summary": "The signed-in user's active sessions.",
				"operationId": "list_sessions",
				"responses": {
					"200": {
						"description": "Active sessions, newest first",
						"content": {
							"application/json": {
								"schema": {
									"type": "array",
									"items": {
										"$ref": "#/components/schemas/SessionView"
									}
								}
							}
						}
					}
				}
			}
		},
		"/api/v1/auth/sessions/{id}": {
			"delete": {
				"tags": ["auth"],
				"summary": "Revokes one of the signed-in user's sessions, e.g. a lost device.",
				"operationId": "revoke_session",
				"parameters": [
					{
						"name": "id",
						"in": "path",
						"description": "Session id",
						"required": true,
						"schema": {
							"type": "string",
							"format": "uuid"
						}
					}
				],
				"responses": {
					"204": {
						"description": "Session revoked"
					},
					"404": {
						"description": "No such session for this user",
						"content": {
							"application/problem+json": {
								"schema": {
									"$ref": "#/components/schemas/ApiError"
								}
							}
						}
					}
				}
			}
		},
		"/healthz": {
			"get": {
				"tags": ["system"],
				"summary": "Liveness probe.",
				"operationId": "healthz",
				"responses": {
					"200": {
						"description": "Process is alive",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/HealthStatus"
								}
							}
						}
					}
				}
			}
		},
		"/readyz": {
			"get": {
				"tags": ["system"],
				"summary": "Readiness probe. Checks the database.",
				"operationId": "readyz",
				"responses": {
					"200": {
						"description": "Ready to serve traffic",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/HealthStatus"
								}
							}
						}
					},
					"503": {
						"description": "A dependency is unavailable",
						"content": {
							"application/problem+json": {
								"schema": {
									"$ref": "#/components/schemas/ApiError"
								}
							}
						}
					}
				}
			}
		}
	},
	"components": {
		"schemas": {
			"ApiError": {
				"type": "object",
				"description": "An RFC 9457 problem details response.",
				"required": ["type", "title", "status"],
				"properties": {
					"detail": {
						"type": ["string", "null"]
					},
					"errors": {
						"type": "array",
						"items": {
							"$ref": "#/components/schemas/FieldError"
						}
					},
					"status": {
						"type": "integer",
						"format": "int32",
						"minimum": 0
					},
					"title": {
						"type": "string"
					},
					"type": {
						"type": "string"
					}
				}
			},
			"ChangePasswordRequest": {
				"type": "object",
				"required": ["currentPassword", "newPassword"],
				"properties": {
					"currentPassword": {
						"type": "string",
						"format": "password"
					},
					"newPassword": {
						"type": "string",
						"format": "password"
					}
				}
			},
			"FieldError": {
				"type": "object",
				"description": "A field-level validation error.",
				"required": ["pointer", "message"],
				"properties": {
					"message": {
						"type": "string"
					},
					"pointer": {
						"type": "string",
						"description": "JSON Pointer to the invalid field, e.g. `/name`."
					}
				}
			},
			"HealthStatus": {
				"type": "object",
				"required": ["status", "version"],
				"properties": {
					"status": {
						"type": "string",
						"description": "Always `ok` when the response is 200."
					},
					"version": {
						"type": "string"
					}
				}
			},
			"LoginRequest": {
				"type": "object",
				"required": ["email", "password"],
				"properties": {
					"email": {
						"type": "string"
					},
					"password": {
						"type": "string",
						"format": "password"
					}
				}
			},
			"SessionView": {
				"type": "object",
				"required": ["id", "createdAt", "expiresAt", "current"],
				"properties": {
					"createdAt": {
						"type": "string",
						"format": "date-time"
					},
					"current": {
						"type": "boolean",
						"description": "True for the session making this request."
					},
					"expiresAt": {
						"type": "string",
						"format": "date-time"
					},
					"id": {
						"type": "string",
						"format": "uuid"
					},
					"ip": {
						"type": ["string", "null"]
					},
					"lastSeenAt": {
						"type": ["string", "null"],
						"format": "date-time"
					},
					"userAgent": {
						"type": ["string", "null"]
					}
				}
			},
			"UserView": {
				"type": "object",
				"required": ["id", "email", "displayName", "status"],
				"properties": {
					"displayName": {
						"type": "string"
					},
					"email": {
						"type": "string"
					},
					"id": {
						"type": "string",
						"format": "uuid"
					},
					"lastLoginAt": {
						"type": ["string", "null"],
						"format": "date-time"
					},
					"status": {
						"type": "string",
						"description": "`active` or `disabled`."
					}
				}
			}
		}
	},
	"tags": [
		{
			"name": "system",
			"description": "Health and platform metadata"
		},
		{
			"name": "auth",
			"description": "Sign-in, sessions, and the current user"
		}
	]
}
