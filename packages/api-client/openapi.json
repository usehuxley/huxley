					"required": true
				},
				"responses": {
					"200": {
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/UserView"
								}
							}
						}
					},
					"409": {
						"content": {
							"application/problem+json": {
								"schema": {
									"$ref": "#/components/schemas/ApiError"
								}
							}
						}
					}
				}
			}
		},
		"/api/v1/users/{id}/assignments": {
			"get": {
				"tags": ["users"],
				"summary": "A user's role assignments that the caller can see.",
				"operationId": "list_assignments",
				"parameters": [
					{
						"name": "id",
						"in": "path",
						"description": "User id",
						"required": true,
						"schema": {
							"type": "string",
							"format": "uuid"
						}
					}
				],
				"responses": {
					"200": {
						"content": {
							"application/json": {
								"schema": {
									"type": "array",
