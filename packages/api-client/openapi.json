{
	"openapi": "3.1.0",
	"info": {
		"title": "Huxley API",
		"description": "Huxley platform API. See https://docs.usehuxley.com for conventions.",
		"license": {
			"name": "MIT",
			"identifier": "MIT"
		},
		"version": "0.1.0"
	},
	"paths": {
		"/api/v1/audit": {
			"get": {
				"tags": ["audit"],
				"summary": "Lists audit events, newest first.",
				"operationId": "list_audit_events",
				"parameters": [
					{
						"name": "limit",
						"in": "query",
						"required": false,
						"schema": {
							"type": ["integer", "null"],
							"format": "int32",
							"minimum": 0
						}
					},
					{
						"name": "cursor",
						"in": "query",
						"required": false,
						"schema": {
							"type": ["string", "null"]
						}
					},
					{
						"name": "action",
						"in": "query",
						"description": "Only actions starting with this prefix, e.g. `auth.` or `org.created`.",
						"required": false,
						"schema": {
							"type": ["string", "null"]
						}
					},
					{
						"name": "targetId",
						"in": "query",
						"description": "Only events about this entity.",
						"required": false,
						"schema": {
							"type": ["string", "null"],
							"format": "uuid"
						}
					}
				],
				"responses": {
					"200": {
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/AuditPage"
								}
							}
						}
					},
					"403": {
						"content": {
							"application/problem+json": {
								"schema": {
									"$ref": "#/components/schemas/ApiError"
								}
							}
						}
					}
				}
			}
		},
		"/api/v1/auth/login": {
			"post": {
				"tags": ["auth"],
				"summary": "Signs in with email and password. Sets the session cookie.",
				"operationId": "login",
				"requestBody": {
					"content": {
						"application/json": {
							"schema": {
								"$ref": "#/components/schemas/LoginRequest"
							}
						}
					},
					"required": true
				},
				"responses": {
					"200": {
						"description": "Signed in; session cookie set",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/UserView"
								}
							}
						}
					},
					"401": {
						"description": "Wrong email or password, or the account is disabled or locked",
						"content": {
							"application/problem+json": {
								"schema": {
									"$ref": "#/components/schemas/ApiError"
								}
							}
						}
					},
					"429": {
						"description": "Too many attempts from this address",
						"content": {
							"application/problem+json": {
								"schema": {
									"$ref": "#/components/schemas/ApiError"
								}
							}
						}
					}
				}
			}
		},
		"/api/v1/auth/logout": {
			"post": {
				"tags": ["auth"],
				"summary": "Signs out the current session and clears the cookie.",
				"operationId": "logout",
				"responses": {
					"204": {
						"description": "Signed out"
					}
				}
			}
		},
		"/api/v1/auth/me": {
			"get": {
				"tags": ["auth"],
				"summary": "The signed-in user.",
				"operationId": "me",
				"responses": {
					"200": {
						"description": "The signed-in user",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/MeView"
								}
							}
						}
					},
					"401": {
						"description": "Not signed in",
						"content": {
							"application/problem+json": {
								"schema": {
									"$ref": "#/components/schemas/ApiError"
								}
							}
						}
					}
				}
			}
		},
		"/api/v1/auth/password": {
			"post": {
				"tags": ["auth"],
				"summary": "Changes the signed-in user's password. Signs out all their other sessions.",
				"operationId": "change_password",
				"requestBody": {
					"content": {
						"application/json": {
							"schema": {
								"$ref": "#/components/schemas/ChangePasswordRequest"
							}
						}
					},
					"required": true
				},
				"responses": {
					"204": {
						"description": "Password changed; other sessions signed out"
					},
					"422": {
						"description": "Current password wrong or new password too weak",
						"content": {
							"application/problem+json": {
								"schema": {
									"$ref": "#/components/schemas/ApiError"
								}
							}
						}
					}
				}
			}
		},
		"/api/v1/auth/sessions": {
			"get": {
				"tags": ["auth"],
				"summary": "The signed-in user's active sessions.",
				"operationId": "list_sessions",
				"responses": {
					"200": {
						"description": "Active sessions, newest first",
						"content": {
							"application/json": {
								"schema": {
									"type": "array",
									"items": {
										"$ref": "#/components/schemas/SessionView"
									}
								}
							}
						}
					}
				}
			}
		},
		"/api/v1/auth/sessions/{id}": {
			"delete": {
				"tags": ["auth"],
				"summary": "Revokes one of the signed-in user's sessions, e.g. a lost device.",
				"operationId": "revoke_session",
				"parameters": [
					{
						"name": "id",
						"in": "path",
						"description": "Session id",
						"required": true,
						"schema": {
							"type": "string",
							"format": "uuid"
						}
					}
				],
				"responses": {
					"204": {
						"description": "Session revoked"
					},
					"404": {
						"description": "No such session for this user",
						"content": {
							"application/problem+json": {
								"schema": {
									"$ref": "#/components/schemas/ApiError"
								}
							}
						}
					}
				}
			}
		},
		"/api/v1/modules": {
			"get": {
				"tags": ["modules"],
				"summary": "Every feature module and whether it's enabled and active.",
				"operationId": "list_modules",
				"responses": {
					"200": {
						"content": {
							"application/json": {
								"schema": {
									"type": "array",
									"items": {
										"$ref": "#/components/schemas/ModuleState"
									}
								}
							}
						}
					}
				}
			}
		},
		"/api/v1/modules/{key}": {
			"put": {
				"tags": ["modules"],
				"summary": "Turns a feature module on or off for the instance. Data is kept when a\nmodule is turned off.",
				"operationId": "set_module",
				"parameters": [
					{
						"name": "key",
						"in": "path",
						"description": "Module key, e.g. `servicedesk`",
						"required": true,
						"schema": {
							"type": "string"
						}
					}
				],
				"requestBody": {
					"content": {
						"application/json": {
							"schema": {
								"$ref": "#/components/schemas/SetModuleRequest"
							}
						}
					},
					"required": true
				},
				"responses": {
					"200": {
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/SetModuleResponse"
								}
							}
						}
					},
					"404": {
						"content": {
							"application/problem+json": {
								"schema": {
									"$ref": "#/components/schemas/ApiError"
								}
							}
						}
					},
					"409": {
						"description": "Missing dependencies, or enabled modules depend on it",
						"content": {
							"application/problem+json": {
								"schema": {
									"$ref": "#/components/schemas/ApiError"
								}
							}
						}
					}
				}
			}
		},
		"/api/v1/orgs": {
			"get": {
				"tags": ["orgs"],
				"summary": "Organizations the caller can see, ordered as a tree (parents before children).",
				"operationId": "list_orgs",
				"responses": {
					"200": {
						"description": "Visible organizations in tree order",
						"content": {
							"application/json": {
								"schema": {
									"type": "array",
									"items": {
										"$ref": "#/components/schemas/Organization"
									}
								}
							}
						}
					}
				}
			},
			"post": {
				"tags": ["orgs"],
				"summary": "Creates a sub-organization.",
				"operationId": "create_org",
				"requestBody": {
					"content": {
						"application/json": {
							"schema": {
								"$ref": "#/components/schemas/CreateOrgRequest"
							}
						}
					},
					"required": true
				},
				"responses": {
					"201": {
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Organization"
								}
							}
						}
					},
					"409": {
						"description": "Name already used by a sibling",
						"content": {
							"application/problem+json": {
								"schema": {
									"$ref": "#/components/schemas/ApiError"
								}
							}
						}
					},
					"422": {
						"content": {
							"application/problem+json": {
								"schema": {
									"$ref": "#/components/schemas/ApiError"
								}
							}
						}
					}
				}
			}
		},
		"/api/v1/orgs/{id}": {
			"get": {
				"tags": ["orgs"],
				"operationId": "get_org",
				"parameters": [
					{
						"name": "id",
						"in": "path",
						"description": "Organization id",
						"required": true,
						"schema": {
							"type": "string",
							"format": "uuid"
						}
					}
				],
				"responses": {
					"200": {
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Organization"
								}
							}
						}
					},
					"404": {
						"content": {
							"application/problem+json": {
								"schema": {
									"$ref": "#/components/schemas/ApiError"
								}
							}
						}
					}
				}
			},
			"patch": {
				"tags": ["orgs"],
				"summary": "Renames an organization.",
				"operationId": "update_org",
				"parameters": [
					{
						"name": "id",
						"in": "path",
						"description": "Organization id",
						"required": true,
						"schema": {
							"type": "string",
							"format": "uuid"
						}
					}
				],
				"requestBody": {
					"content": {
						"application/json": {
							"schema": {
								"$ref": "#/components/schemas/UpdateOrgRequest"
							}
						}
					},
					"required": true
				},
				"responses": {
					"200": {
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Organization"
								}
							}
						}
					},
					"409": {
						"content": {
							"application/problem+json": {
								"schema": {
									"$ref": "#/components/schemas/ApiError"
								}
							}
						}
					}
				}
			}
		},
		"/api/v1/orgs/{id}/archive": {
			"post": {
				"tags": ["orgs"],
				"summary": "Archives an organization with no active sub-organizations.",
				"operationId": "archive_org",
				"parameters": [
					{
						"name": "id",
						"in": "path",
						"description": "Organization id",
						"required": true,
						"schema": {
							"type": "string",
							"format": "uuid"
						}
					}
				],
				"requestBody": {
					"content": {
						"application/json": {
							"schema": {
								"$ref": "#/components/schemas/ArchiveOrgRequest"
							}
						}
					},
					"required": true
				},
				"responses": {
					"200": {
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Organization"
								}
							}
						}
					},
					"409": {
						"content": {
							"application/problem+json": {
								"schema": {
									"$ref": "#/components/schemas/ApiError"
								}
							}
						}
					}
				}
			}
		},
		"/api/v1/orgs/{id}/move": {
			"post": {
				"tags": ["orgs"],
				"summary": "Moves an organization and its subtree under a new parent. Requires\n`org:move` on the organization and `org:create` on the new parent.",
				"operationId": "move_org",
				"parameters": [
					{
						"name": "id",
						"in": "path",
						"description": "Organization id",
						"required": true,
						"schema": {
							"type": "string",
							"format": "uuid"
						}
					}
				],
				"requestBody": {
					"content": {
						"application/json": {
							"schema": {
								"$ref": "#/components/schemas/MoveOrgRequest"
							}
						}
					},
					"required": true
				},
				"responses": {
					"200": {
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Organization"
								}
							}
						}
					},
					"422": {
						"content": {
							"application/problem+json": {
								"schema": {
									"$ref": "#/components/schemas/ApiError"
								}
							}
						}
					}
				}
			}
		},
		"/api/v1/permissions": {
			"get": {
				"tags": ["users"],
				"summary": "Every permission Huxley checks.",
				"operationId": "list_permissions",
				"responses": {
					"200": {
						"content": {
							"application/json": {
								"schema": {
									"type": "array",
									"items": {
										"$ref": "#/components/schemas/Permission"
									}
								}
							}
						}
					}
				}
			}
		},
		"/api/v1/role-assignments": {
			"post": {
				"tags": ["users"],
				"summary": "Grants a role to a user at an organization.",
				"operationId": "create_assignment",
				"requestBody": {
					"content": {
						"application/json": {
							"schema": {
								"$ref": "#/components/schemas/CreateAssignmentRequest"
							}
						}
					},
					"required": true
				},
				"responses": {
					"201": {
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Assignment"
								}
							}
						}
					},
					"403": {
						"content": {
							"application/problem+json": {
								"schema": {
									"$ref": "#/components/schemas/ApiError"
								}
							}
						}
					},
					"409": {
						"content": {
							"application/problem+json": {
								"schema": {
									"$ref": "#/components/schemas/ApiError"
								}
							}
						}
					}
				}
			}
		},
		"/api/v1/role-assignments/{id}": {
			"delete": {
				"tags": ["users"],
				"summary": "Removes a role assignment.",
				"operationId": "delete_assignment",
				"parameters": [
					{
						"name": "id",
						"in": "path",
						"description": "Assignment id",
						"required": true,
						"schema": {
							"type": "string",
							"format": "uuid"
						}
					}
				],
				"responses": {
					"204": {},
					"409": {
						"description": "Would remove the last owner",
						"content": {
							"application/problem+json": {
								"schema": {
									"$ref": "#/components/schemas/ApiError"
								}
							}
						}
					}
				}
			}
		},
		"/api/v1/roles": {
			"get": {
				"tags": ["users"],
				"summary": "Roles that can be assigned.",
				"operationId": "list_roles",
				"responses": {
					"200": {
						"content": {
							"application/json": {
								"schema": {
									"type": "array",
									"items": {
										"$ref": "#/components/schemas/Role"
									}
								}
							}
						}
					}
				}
			}
		},
		"/api/v1/users": {
			"get": {
				"tags": ["users"],
				"summary": "Lists users.",
				"operationId": "list_users",
				"parameters": [
					{
						"name": "limit",
						"in": "query",
						"description": "Page size, 1 to 200 (default 50).",
						"required": false,
						"schema": {
							"type": ["integer", "null"],
							"format": "int32",
							"minimum": 0
						}
					},
					{
						"name": "cursor",
						"in": "query",
						"description": "Opaque cursor from the previous page's `nextCursor`.",
						"required": false,
						"schema": {
							"type": ["string", "null"]
						}
					}
				],
				"responses": {
					"200": {
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/UserPage"
								}
							}
						}
					},
					"403": {
						"content": {
							"application/problem+json": {
								"schema": {
									"$ref": "#/components/schemas/ApiError"
								}
							}
						}
					}
				}
			},
			"post": {
				"tags": ["users"],
				"summary": "Creates a local user. The new user has no roles until one is assigned.",
				"operationId": "create_user",
				"requestBody": {
					"content": {
						"application/json": {
							"schema": {
								"$ref": "#/components/schemas/CreateUserRequest"
							}
						}
					},
					"required": true
				},
				"responses": {
					"201": {
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/CreateUserResponse"
								}
							}
						}
					},
					"409": {
						"content": {
							"application/problem+json": {
								"schema": {
									"$ref": "#/components/schemas/ApiError"
								}
							}
						}
					},
					"422": {
						"content": {
							"application/problem+json": {
								"schema": {
									"$ref": "#/components/schemas/ApiError"
								}
							}
						}
					}
				}
			}
		},
		"/api/v1/users/{id}": {
			"get": {
				"tags": ["users"],
				"operationId": "get_user",
				"parameters": [
					{
						"name": "id",
						"in": "path",
						"description": "User id",
						"required": true,
						"schema": {
							"type": "string",
							"format": "uuid"
						}
					}
				],
				"responses": {
					"200": {
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/UserView"
								}
							}
						}
					},
					"404": {
						"content": {
							"application/problem+json": {
								"schema": {
									"$ref": "#/components/schemas/ApiError"
								}
							}
						}
					}
				}
			},
			"patch": {
				"tags": ["users"],
				"summary": "Edits a user's name or status.",
				"operationId": "update_user",
				"parameters": [
					{
						"name": "id",
						"in": "path",
						"description": "User id",
						"required": true,
						"schema": {
							"type": "string",
							"format": "uuid"
						}
					}
				],
				"requestBody": {
					"content": {
						"application/json": {
							"schema": {
								"$ref": "#/components/schemas/UpdateUserRequest"
							}
