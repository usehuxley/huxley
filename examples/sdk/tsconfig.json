{
	"compilerOptions": {
		"strict": true,
		"target": "es2024",
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"verbatimModuleSyntax": true,
		"allowImportingTsExtensions": true,
		"erasableSyntaxOnly": true,
		"isolatedModules": true,
		"skipLibCheck": true,
		"noEmit": true,
		"lib": ["es2024"]
	},
	"include": ["**/*.ts"],
	"exclude": ["node_modules", "dist"]
}
